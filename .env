# Configurações Comuns
SPRING_LOCALE=pt_BR
SPRING_ENCODING=UTF-8
CACHE_MAX_SIZE=500
CACHE_EXPIRE_TIME=30m

EMAIL_USERNAME =user
EMAIL_PASSWORD_USERNAME =password

# Logging
LOGGING_FILE_NAME=logs/application.log
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_MAX_HISTORY=7
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SPRING=WARN
LOGGING_LEVEL_HIBERNATE=WARN
LOGGING_LEVEL_APP=INFO

# Desenvolvimento
DEV_DB_USERNAME=postgres
DEV_DB_PASSWORD=banco321
DEV_SECURITY_USER=admin
DEV_SERVER_PORT=8090
DEV_DB_PORT=5432
DEV_SECURITY_PASSWORD=admin123

# Homologação
HOMOLOG_DB_USERNAME=homolog_user
HOMOLOG_DB_PASSWORD=homolog_password
HOMOLOG_SERVER_PORT=8091
HOMOLOG_DB_PORT=5432
HOMOLOG_SECURITY_USER=homolog_admin
HOMOLOG_SECURITY_PASSWORD=homolog_password

# Produção
PROD_DB_URL=jdbc:postgresql://prod-server:5432/pizzaria_prod
PROD_DB_USERNAME=postgres
PROD_DB_PASSWORD=prod_password
PROD_SECURITY_USER=prod_admin
PROD_SECURITY_PASSWORD=prod_password
